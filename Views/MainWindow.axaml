<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PMCL.Localization"
        xmlns:vm="using:PMCL.ViewModels"
        xmlns:views="using:PMCL.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
        x:Class="PMCL.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PMCL - Philia093's MineCraft Launcher"
        Width="1240" Height="720"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2233" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#222C40" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A32416" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="36,*">
        <Grid Grid.Row="0"
              Name="TitleBar"
              ColumnDefinitions="228,*,Auto"
              Background="Transparent"
              PointerPressed="TitleBar_PointerPressed"
              DoubleTapped="TitleBar_DoubleTapped">
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="#1B2233"
                    BorderThickness="0,0,1,0" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch">
                <Button Classes="caption"
                        Content="—"
                        ToolTip.Tip="{loc:Tr Window.Minimize}"
                        Click="MinimizeButton_Click" />
                <Button Classes="caption"
                        Name="MaximizeButton"
                        Content="□"
                        ToolTip.Tip="{loc:Tr Window.MaximizeRestore}"
                        Click="MaximizeButton_Click" />
                <Button Classes="caption close"
                        Content="✕"
                        ToolTip.Tip="{loc:Tr Window.Close}"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="228,*">
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="#1B2233"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto" Margin="16,20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr Nav.Title}" Classes="muted"
                                   Margin="12,0,0,8"
                                   FontSize="10"
                                   FontWeight="Bold" />

                        <Button Classes="nav" Classes.active="{Binding IsHomeSelected}"
                                Command="{Binding NavigateHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="◈" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Nav.Home}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsVersionsSelected}"
                                Command="{Binding NavigateVersionsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="▤" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Nav.Versions}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsAccountSelected}"
                                Command="{Binding NavigateAccountCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="☺" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Nav.Accounts}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsSettingsSelected}"
                                Command="{Binding NavigateSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⚙" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Nav.Settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Background="#101725"
                                BorderBrush="#1F2A3C"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,18,0,0"
                                IsVisible="{Binding Session.IsGameRunning}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr Game.Running}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding Session.GameRunningVersion}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Session.GameElapsedText}"
                                           Classes="muted"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding AppVersionText}"
                               Classes="muted"
                               FontSize="10" />
                </Grid>
            </Border>


            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,18,24,10">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}"
                                   Classes="muted" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="ghost"
                            Padding="8"
                            VerticalAlignment="Center"
                            Command="{Binding NavigateAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{StaticResource AccentBrush}">
                                <TextBlock Text="{Binding Session.AccountInitial}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Session.AccountName}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Session.AccountKindLabel}"
                                           Classes="muted"
                                           FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Classes="card"
                        Background="#1C1520"
                        BorderBrush="#432432"
                        Padding="14"
                        Margin="24,0,24,10"
                        IsVisible="{Binding Session.HasError}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="!"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Session.LastError}"
                                   Foreground="#FFD5DA"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="ghost"
                                Padding="8,2"
                                Content="{loc:Tr Game.Close}"
                                Command="{Binding Session.ClearErrorCommand}" />
                    </Grid>
                </Border>

                <ContentControl Grid.Row="2"
                                Content="{Binding CurrentPage}"
                                Margin="24,4,24,12" />

                <Border Grid.Row="3"
                        BorderBrush="#1B2233"
                        BorderThickness="0,1,0,0"
                        Padding="24,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7"
                                     Fill="{StaticResource SuccessBrush}"
                                     IsVisible="{Binding !Session.HasError}"
                                     VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7"
                                     Fill="{StaticResource DangerBrush}"
                                     IsVisible="{Binding Session.HasError}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Session.StatusMessage}"
                                       Classes="muted"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Tr App.Tagline}"
                                   Classes="muted"
                                   FontSize="10"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>


        <Border Grid.Row="1"
                Background="#CC070A10"
                IsVisible="{Binding Versions.LoaderSelector.IsOpen}">
            <views:ModLoaderSelectorView DataContext="{Binding Versions.LoaderSelector}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="24" />
        </Border>

        <Border Grid.Row="1"
                Background="#CC070A10"
                IsVisible="{Binding VersionSettings.LoaderSelector.IsOpen}">
            <views:ModLoaderSelectorView DataContext="{Binding VersionSettings.LoaderSelector}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="24" />
        </Border>

        <Border Grid.Row="1"
                Background="#C4070A10"
                IsVisible="{Binding Session.IsBusy}">
            <Border Classes="card"
                    Width="430"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressBar Width="56"
                                     Height="4"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding Session.IsGameStarting}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr Busy.Title}" Classes="h2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Session.StatusMessage}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <ProgressBar Minimum="0" Maximum="1"
                                 Value="{Binding Session.Progress}"
                                 IsIndeterminate="{Binding Session.IsProgressIndeterminate}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Session.ProgressPercentText}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Session.DownloadSpeedText}"
                                   Classes="muted"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Session.DownloadBytesText}"
                               Classes="muted"
                               IsVisible="{Binding Session.HasDownloadMetrics}" />
                    <TextBlock Text="{Binding Session.DownloadSourceText}"
                               Classes="muted"
                               FontSize="10" />
                    <TextBlock Text="{loc:Tr Busy.Hint}"
                               Classes="muted"
                               FontSize="10" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Row="1"
                Background="#D4070A10"
                IsVisible="{Binding Session.IsGameClosePromptVisible}">
            <Border Classes="card"
                    Width="440"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr Game.CloseTitle}" Classes="h2" />
                        <TextBlock Text="{Binding Session.GameRunningVersion}"
                                   FontWeight="SemiBold"
                                   Foreground="#C3B5FF" />
                        <TextBlock Text="{Binding Session.GameElapsedText}"
                                   Classes="muted"
                                   FontSize="12" />
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Game.ClosePrompt}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="{loc:Tr Game.Continue}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding Session.DismissGameClosePromptCommand}" />
                        <Button Grid.Column="1"
                                Classes="danger"
                                Content="{loc:Tr Game.CloseGame}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding Session.CloseGameCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

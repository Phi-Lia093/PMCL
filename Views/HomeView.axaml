<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PMCL.Localization"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:models="using:PMCL.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border CornerRadius="18" Padding="28" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2C1F63" Offset="0" />
                        <GradientStop Color="#131926" Offset="0.62" />
                        <GradientStop Color="#131926" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="MINECRAFT JAVA EDITION"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   LetterSpacing="2.5"
                                   Foreground="#B9A9FF" />
                        <TextBlock Text="{loc:Tr Home.HeroTitle}"
                                   Classes="h1"
                                   FontSize="32" />
                        <TextBlock Text="{loc:Tr Home.HeroSubtitle}"
                                   Classes="muted"
                                   FontSize="13"
                                   MaxWidth="460"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0" MaxWidth="560"
                              HorizontalAlignment="Left">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Session.InstalledVersions}"
                                      SelectedItem="{Binding Session.SelectedVersion}"
                                      MinWidth="220"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding Session.HasInstalledVersions}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameVersion">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LoaderBadge}"
                                                       Classes="muted"
                                                       Foreground="#C3B5FF"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsModded}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <Button Classes="primary"
                                        Padding="30,12"
                                        FontSize="15"
                                        Command="{Binding LaunchCommand}"
                                        IsEnabled="{Binding Session.CanStartGame}"
                                        IsVisible="{Binding !Session.IsGameRunning}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ProgressBar Width="20"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     IsIndeterminate="True"
                                                     IsVisible="{Binding Session.IsGameStarting}" />
                                        <TextBlock Text="{loc:Tr Home.StartGame}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !Session.IsGameStarting}" />
                                        <TextBlock Text="{loc:Tr Home.Starting}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding Session.IsGameStarting}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary"
                                        Padding="30,12"
                                        FontSize="15"
                                        Content="{Binding Session.GameRunningButtonText}"
                                        Command="{Binding ShowGameSessionCommand}"
                                        IsVisible="{Binding Session.IsGameRunning}"
                                        ToolTip.Tip="{loc:Tr Home.RunningTip}" />
                            </Grid>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="secondary"
                                    Content="{loc:Tr Home.VersionSettings}"
                                    Command="{Binding OpenVersionSettingsCommand}"
                                    IsEnabled="{Binding Session.CanOpenVersionSettings}" />
                            <TextBlock Classes="muted"
                                       VerticalAlignment="Center"
                                       Text="{Binding Session.SelectedVersionName}" />
                            <TextBlock Classes="muted"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !Session.HasInstalledVersions}"
                                       Text="{loc:Tr Home.NoVersions}" />
                        </StackPanel>

                        <Border IsVisible="{Binding !Session.VersionsLoaded}"
                                Background="#1F1A33"
                                CornerRadius="10"
                                Padding="12"
                                MaxWidth="560"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{loc:Tr Home.VersionsNotLoaded}"
                                           Classes="muted"
                                           VerticalAlignment="Center" />
                                <Button Classes="ghost"
                                        Padding="10,4"
                                        Content="{loc:Tr Home.Reload}"
                                        Command="{Binding RefreshVersionsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="PMCL"
                               FontSize="86"
                               FontWeight="Black"
                               Foreground="#22FFFFFF"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,-18" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.7*,1*">
                <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Tr Home.CurrentAccount}" Classes="h2" FontSize="16" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="52" Height="52"
                                    CornerRadius="26"
                                    Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Session.AccountInitial}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding Session.AccountName}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Session.AccountKindLabel}" Classes="muted" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Tr Home.AccountHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <Button Classes="secondary"
                                HorizontalAlignment="Left"
                                Content="{loc:Tr Home.SwitchAccount}"
                                Command="{Binding OpenAccountCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Tr Home.Environment}" Classes="h2" FontSize="16" />

                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr Home.VersionJava}" Classes="label" Margin="0" />
                            <TextBlock Text="{Binding Session.SelectedVersionSettings.JavaDisplay}"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr Home.Memory}" Classes="label" Margin="0" />
                            <TextBlock Text="{Binding Session.SelectedVersionSettings.MemoryDisplay}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr Home.GameDirectory}" Classes="label" Margin="0" />
                            <TextBlock Text="{Binding Session.Settings.GameDirectory}"
                                       Classes="muted"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />
                        </StackPanel>

                        <TextBlock Text="{loc:Tr Home.EnvironmentHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

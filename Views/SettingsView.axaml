<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PMCL.Localization"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border Classes="card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr Settings.GameDirectory}" Classes="h2" FontSize="16" />
                        <TextBlock Text="{loc:Tr Settings.GameDirectoryHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding GameDirectory}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{loc:Tr Common.Browse}"
                                Command="{Binding BrowseGameDirectoryCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Classes="ghost"
                                Padding="0,4"
                                Content="{loc:Tr Settings.ResetDirectory}"
                                Command="{Binding ResetGameDirectoryCommand}" />
                        <TextBlock Text="{loc:Tr Settings.DirectoryReloadHint}"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr Settings.DownloadSource}" Classes="h2" FontSize="16" />
                        <TextBlock Text="{loc:Tr Settings.DownloadSourceHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding DownloadSourceOptions}"
                              SelectedIndex="{Binding SelectedDownloadSourceIndex, Mode=TwoWay}" />

                    <TextBlock Text="{Binding DownloadSourceDescription}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr Settings.WindowTray}" Classes="h2" FontSize="16" />
                        <TextBlock Text="{loc:Tr Settings.WindowTrayHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr Settings.WhenClose}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding CloseActionOptions}"
                                      SelectedIndex="{Binding SelectedCloseActionIndex, Mode=TwoWay}" />
                            <TextBlock Text="{loc:Tr Settings.CloseHint}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{loc:Tr Settings.AfterLaunch}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding GameLaunchActionOptions}"
                                      SelectedIndex="{Binding SelectedGameLaunchActionIndex, Mode=TwoWay}" />
                            <TextBlock Text="{loc:Tr Settings.LaunchHint}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding RestoreAfterGameExit, Mode=TwoWay}"
                              Content="{loc:Tr Settings.RestoreAfterExit}" />

                    <TextBlock Text="{loc:Tr Settings.SaveHint}"
                               Classes="muted"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr Settings.Language}" Classes="h2" FontSize="16" />
                            <TextBlock Text="{loc:Tr Settings.LanguageHint}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr Settings.Data}" Classes="h2" FontSize="16" />
                            <TextBlock Text="{loc:Tr Settings.DataHint}"
                                       Classes="muted" />
                        </StackPanel>
                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="#263045"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <TextBlock Text="{Binding DataDirectory}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr Settings.VersionSettingsMoved}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr Settings.VersionSettingsHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="primary"
                            Content="{loc:Tr Settings.Save}"
                            Padding="24,10"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !Session.IsBusy}"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
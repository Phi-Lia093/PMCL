<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border Classes="card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="游戏目录" Classes="h2" FontSize="16" />
                        <TextBlock Text="版本元数据与共享的 libraries / assets / runtime 保存在这个 .minecraft 目录中；每个版本的存档、截图、模组与配置会自动隔离在 versions\&lt;版本名&gt; 内，互不影响。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding GameDirectory}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="浏览"
                                Command="{Binding BrowseGameDirectoryCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Classes="ghost"
                                Padding="0,4"
                                Content="恢复默认目录"
                                Command="{Binding ResetGameDirectoryCommand}" />
                        <TextBlock Text="修改后会重新加载版本列表。"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="下载源" Classes="h2" FontSize="16" />
                        <TextBlock Text="官方源优先使用 Mojang 与各加载器官方地址，不依赖 BMCLAPI；镜像仅用于加速或回退。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding DownloadSourceOptions}"
                              SelectedIndex="{Binding SelectedDownloadSourceIndex, Mode=TwoWay}" />

                    <TextBlock Text="{Binding DownloadSourceDescription}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="界面语言" Classes="h2" FontSize="16" />
                            <TextBlock Text="多语言将在后续版本提供，当前仅支持简体中文。"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="启动器数据" Classes="h2" FontSize="16" />
                            <TextBlock Text="设置、账户缓存与日志保存在这里。"
                                       Classes="muted" />
                        </StackPanel>
                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="#263045"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <TextBlock Text="{Binding DataDirectory}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="版本专属设置已移至「版本设置」"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="请在主页选择已下载的版本，点击「版本设置」调整 Java、内存、窗口、登录方式、自动进服、JVM/游戏参数与启动前命令。每个版本的配置都会持久保存。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="primary"
                            Content="保存全局设置"
                            Padding="24,10"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !Session.IsBusy}"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

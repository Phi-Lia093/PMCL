<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="游戏与 Java" Classes="h2" FontSize="16" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="游戏目录" Classes="label" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding GameDirectory}" />
                                <Button Grid.Column="1" Classes="secondary"
                                        Content="浏览" Command="{Binding BrowseGameDirectoryCommand}" />
                            </Grid>
                            <Button Classes="ghost" Padding="0,4"
                                    HorizontalAlignment="Left"
                                    Content="恢复默认目录"
                                    Command="{Binding ResetGameDirectoryCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Java 可执行文件" Classes="label" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding JavaPath}"
                                         PlaceholderText="留空则自动检测" />
                                <Button Grid.Column="1" Classes="secondary"
                                        Content="浏览" Command="{Binding BrowseJavaCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="ghost" Padding="0,4"
                                        Content="清除路径"
                                        Command="{Binding ClearJavaPathCommand}" />
                                <TextBlock Classes="muted"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Session.JavaSummary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="内存与窗口" Classes="h2" FontSize="16" />

                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="最小内存 (MB)" Classes="label" />
                                <NumericUpDown Value="{Binding MinimumRamMb}"
                                               Minimum="512" Maximum="32768"
                                               Increment="512"
                                               FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="最大内存 (MB)" Classes="label" />
                                <NumericUpDown Value="{Binding MaximumRamMb}"
                                               Minimum="512" Maximum="32768"
                                               Increment="512"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="窗口宽度" Classes="label" />
                                <NumericUpDown Value="{Binding WindowWidth}"
                                               Minimum="640" Maximum="7680"
                                               Increment="10"
                                               FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="窗口高度" Classes="label" />
                                <NumericUpDown Value="{Binding WindowHeight}"
                                               Minimum="480" Maximum="4320"
                                               Increment="10"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="全屏启动游戏"
                                  IsChecked="{Binding FullScreen}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="修改游戏目录后会自动重新加载版本列表。"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="primary"
                            Content="保存设置"
                            Padding="26,10"
                            IsEnabled="{Binding !Session.IsBusy}"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

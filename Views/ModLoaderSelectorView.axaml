<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PMCL.Localization"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:services="using:PMCL.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="680"
             x:Class="PMCL.Views.ModLoaderSelectorView"
             x:DataType="vm:ModLoaderSelectorViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#182133" />
        </Style>
        <Style Selector="Border.loader-card">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#253047" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.loader-card">
            <Setter Property="BorderBrush" Value="#3A4560" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#28224A" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.loader-card">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#241F3F" />
        </Style>
    </UserControl.Styles>

    <Border Classes="card"
            Width="840"
            MaxHeight="620"
            Padding="24"
            CornerRadius="18">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" Classes="h2" FontSize="20" />
                    <TextBlock Text="{Binding Subtitle}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon"
                        Content="✕"
                        FontSize="16"
                        VerticalAlignment="Top"
                        IsEnabled="{Binding !IsInstalling}"
                        Command="{Binding CloseCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,0,6,0">

                    <Border Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            IsVisible="{Binding ShowReplacementWarning}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Loader.MutexTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding ExistingLoaderText}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Tr Loader.MutexHint}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Tr Loader.Select}" Classes="label" />
                            <TextBlock Grid.Column="1"
                                       Text="{loc:Tr Loader.Single}"
                                       Classes="muted"
                                       FontSize="10" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                        <TextBlock Text="{Binding LoadingText}"
                                   Classes="muted"
                                   IsVisible="{Binding IsLoading}" />

                        <ListBox ItemsSource="{Binding Loaders}"
                                 SelectedItem="{Binding SelectedLoader}"
                                 IsVisible="{Binding !IsLoading}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModLoaderChoiceViewModel">
                                    <Border Classes="loader-card"
                                            Width="238"
                                            MinHeight="98"
                                            Padding="13"
                                            CornerRadius="12"
                                            Opacity="{Binding CardOpacity}"
                                            IsEnabled="{Binding IsAvailable}">
                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <Border Grid.Column="1"
                                                        Background="#1B2233"
                                                        CornerRadius="5"
                                                        Padding="6,1">
                                                    <TextBlock Text="{loc:Tr Loader.Single}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding IsAvailable}" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding !IsAvailable}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Border Background="#0F1520"
                            BorderBrush="#263045"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr Loader.Version}" Classes="label" />
                                    <ComboBox ItemsSource="{Binding SelectedLoader.Versions}"
                                              SelectedIndex="{Binding SelectedLoader.SelectedVersionIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="services:ModLoaderVersionOption">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Note}"
                                                               Classes="muted"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Tr Loader.SingleHint}"
                                           Classes="muted"
                                           VerticalAlignment="Bottom"
                                           FontSize="10" />
                            </Grid>


                            <StackPanel Spacing="5">
                                <TextBlock Text="{loc:Tr Loader.InstallerJava}" Classes="label" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding JavaPath}"
                                             PlaceholderText="{loc:Tr Loader.JavaPlaceholder}" />
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Content="{loc:Tr Common.Browse}"
                                            Command="{Binding BrowseJavaCommand}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="ghost"
                                            Padding="0,2"
                                            Content="{loc:Tr Common.ClearPath}"
                                            Command="{Binding ClearJavaCommand}" />
                                    <TextBlock Text="{Binding DetectedJavaText}"
                                               Classes="muted"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding JavaRequirementText}"
                                           Classes="muted"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFD5DA"
                                   TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="{loc:Tr Loader.DoneHint}"
                           Classes="muted"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Content="{loc:Tr Common.Cancel}"
                        IsEnabled="{Binding !IsInstalling}"
                        Command="{Binding CloseCommand}" />
                <Button Grid.Column="2"
                        Classes="primary"
                        Padding="20,9"
                        Content="{Binding ConfirmText}"
                        IsEnabled="{Binding CanInstall}"
                        Command="{Binding InstallCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

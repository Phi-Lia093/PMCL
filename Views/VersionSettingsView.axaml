<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.VersionSettingsView"
             x:DataType="vm:VersionSettingsViewModel">

    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Button Classes="secondary"
                            Content="← 返回"
                            VerticalAlignment="Center"
                            Command="{Binding BackCommand}" />

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Version.Name}"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <Border Background="#1B2233" CornerRadius="6" Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version.TypeLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                                    Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VersionStatusText}"
                                           FontSize="10"
                                           Foreground="#C3B5FF" />
                            </Border>
                            <Border Background="#1B2233" CornerRadius="6"
                                    Padding="7,2" VerticalAlignment="Center"
                                    IsVisible="{Binding HasModLoader}">
                                <TextBlock Text="{Binding CurrentLoaderLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding VersionDirectory}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SaveState}"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                        <Button Classes="primary"
                                Content="保存设置"
                                Padding="20,9"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="nav"
                            Classes.active="{Binding IsSettingsSection}"
                            Padding="18,8"
                            Content="设置"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Settings" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsModsSection}"
                            Padding="18,8"
                            Content="模组"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Mods" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsModDownloadsSection}"
                            Padding="18,8"
                            Content="模组下载"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="ModDownloads" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsAdvancedSection}"
                            Padding="18,8"
                            Content="高级"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Advanced" />
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsSettingsSection}">
                <StackPanel Spacing="14">
                    <TextBlock Text="版本信息" Classes="h2" FontSize="16" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="版本名" Classes="label" />
                            <TextBox Text="{Binding NewVersionName}"
                                     IsEnabled="{Binding !Session.IsBusy}" />
                            <TextBlock Text="重命名会同时修改版本文件夹、版本 json 与同名 jar 文件名。"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="重命名"
                                VerticalAlignment="Bottom"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding RenameVersionCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsSettingsSection}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="快捷操作" Classes="h2" FontSize="16" />
                            <TextBlock Text="所有文件夹都会在 Windows 资源管理器中打开。"
                                       Classes="muted" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="补全文件"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding RepairCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="打开版本文件夹"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenVersionFolderCommand}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="打开存档文件夹"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenSavesFolderCommand}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="打开截图文件夹"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenScreenshotsFolderCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Classes="secondary"
                                Content="导出启动脚本"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding ExportLaunchScriptCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="脚本包含当前登录令牌与完整启动参数，请妥善保管。"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsAdvancedSection}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="游戏数据目录（自动隔离）" Classes="h2" FontSize="16" />
                        <TextBlock Text="每个版本都有独立的游戏目录：存档、截图、mods、config、resourcepacks、shaderpacks 与 options.txt 都保存在这里，模组不会串到其它版本；libraries、assets 与 runtime 仍共享，不会重复下载。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="当前游戏目录" Classes="label" />
                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="#263045"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <TextBlock Text="{Binding GameDirectory}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                Content="打开游戏目录"
                                Command="{Binding OpenGameFolderCommand}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                Content="打开 mods"
                                Command="{Binding OpenModsFolderCommand}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                Content="打开 config"
                                Command="{Binding OpenConfigFolderCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Classes="secondary"
                                Content="导入旧共享数据"
                                IsEnabled="{Binding CanImportSharedData}"
                                Command="{Binding ImportSharedDataCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="用于从旧版共享布局迁移：把共享 .minecraft 中的 存档、截图、mods、config、resourcepacks、shaderpacks 与 options.txt 复制到本版本（只复制、不移动，且不覆盖同名文件）。"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsModLoaderCardVisible}">
                <StackPanel Spacing="14">
                    <TextBlock Text="模组加载器" Classes="h2" FontSize="16" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLoaderLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LoaderBaseVersionLabel}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary"
                                    Content="添加模组加载器"
                                    IsVisible="{Binding IsVanillaVersion}"
                                    IsEnabled="{Binding !Session.IsBusy}"
                                    Command="{Binding AddOrChangeLoaderCommand}" />
                            <Button Classes="secondary"
                                    Content="更换模组加载器"
                                    IsVisible="{Binding HasModLoader}"
                                    IsEnabled="{Binding !Session.IsBusy}"
                                    Command="{Binding AddOrChangeLoaderCommand}" />
                            <Button Classes="danger"
                                    Content="移除模组加载器"
                                    IsVisible="{Binding HasModLoader}"
                                    IsEnabled="{Binding !Session.IsBusy}"
                                    Command="{Binding RequestRemoveLoaderCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="已安装的模组加载器会作为独立版本显示在主页；选择该加载器版本后，可在版本设置中更换或移除。"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <TextBlock Text="同一 Minecraft 版本只保留一个模组加载器。添加或更换会自动下载对应加载器，并替换旧的加载器版本；该版本的存档、截图与模组会先迁移到新加载器，不会随旧版本删除。移除加载器后会把数据合并回原版版本，版本设置会尽量保留。"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <Border IsVisible="{Binding IsRemoveLoaderConfirmVisible}"
                            Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="确定移除此模组加载器吗？只会删除加载器版本文件夹，原版版本和共享游戏文件会保留。"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="danger"
                                        Content="确认移除"
                                        IsEnabled="{Binding !Session.IsBusy}"
                                        Command="{Binding ConfirmRemoveLoaderCommand}" />
                                <Button Classes="secondary"
                                        Content="取消"
                                        Command="{Binding CancelRemoveLoaderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsModsSection}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="已安装模组" Classes="h2" FontSize="16" />
                            <TextBlock Text="{Binding ModsDirectory}"
                                       Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="刷新"
                                Command="{Binding RefreshModsCommand}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="打开 mods"
                                Command="{Binding OpenModsFolderCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding LocalModSearchText}"
                                 PlaceholderText="搜索本地模组文件名" />
                        <CheckBox Grid.Column="1"
                                  Content="显示已禁用"
                                  IsChecked="{Binding ShowDisabledMods}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding LocalModStatusText}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <Border IsVisible="{Binding HasNoLocalMods}"
                            Background="{StaticResource FieldBrush}"
                            BorderBrush="#263045"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <TextBlock Text="没有找到模组文件。把手动下载的 .jar 放进 mods 文件夹，或使用下方 Modrinth 搜索。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding LocalMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModItemViewModel">
                                <Border Background="{StaticResource FieldBrush}"
                                        BorderBrush="#263045"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold" />
                                                    <Border Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="10"
                                                                   Foreground="#C3B5FF" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           Classes="muted"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeText}"
                                                       Classes="muted"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Button Classes="secondary"
                                                        Padding="12,7"
                                                        Content="{Binding ToggleLabel}"
                                                        ToolTip.Tip="{Binding ToggleHint}"
                                                        Command="{Binding ToggleCommand}" />
                                                <Button Classes="danger"
                                                        Padding="12,7"
                                                        Content="删除"
                                                        IsVisible="{Binding !IsDeleteConfirmVisible}"
                                                        Command="{Binding RequestDeleteCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                                                Background="#2A1620"
                                                BorderBrush="#6E2B39"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Text="删除后无法恢复，确定继续吗？"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Classes="danger"
                                                        Padding="12,6"
                                                        Content="确认删除"
                                                        Command="{Binding ConfirmDeleteCommand}" />
                                                <Button Grid.Column="2"
                                                        Classes="secondary"
                                                        Padding="12,6"
                                                        Content="取消"
                                                        Command="{Binding CancelDeleteCommand}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsModDownloadsSection}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="从 Modrinth 下载模组" Classes="h2" FontSize="16" />
                        <TextBlock Text="{Binding ModrinthCompatibilityText}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="模组类型" Classes="muted" FontSize="12" />
                            <ComboBox ItemsSource="{Binding ModrinthCategoryOptions}"
                                      SelectedIndex="{Binding SelectedModrinthCategoryIndex}"
                                      IsEnabled="{Binding CanUseModrinth}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModrinthCategoryOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="下载源" Classes="muted" FontSize="12" />
                            <ComboBox ItemsSource="{Binding ModrinthSourceOptions}"
                                      SelectedIndex="{Binding SelectedModrinthSourceIndex}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="该下载源尚未接入，当前仅支持 Modrinth。"
                               Classes="muted"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !IsModrinthSourceSelected}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding ModrinthSearchText}"
                                 PlaceholderText="搜索 Modrinth 模组；留空显示热门兼容模组"
                                 IsEnabled="{Binding CanUseModrinth}" />
                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="{Binding ModrinthSearchButtonText}"
                                IsEnabled="{Binding CanSearchModrinth}"
                                Command="{Binding SearchModrinthCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding ModrinthStatusText}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding ModrinthResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModrinthProjectItemViewModel">
                                <Border Background="{StaticResource FieldBrush}"
                                        BorderBrush="#263045"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" />
                                                <Border Background="#1B2233"
                                                        CornerRadius="6"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding VersionSummary}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="muted"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AuthorText}"
                                                       Classes="muted"
                                                       FontSize="10" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="6"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <Button Classes="primary"
                                                    Padding="14,8"
                                                    Content="{Binding InstallLabel}"
                                                    IsEnabled="{Binding !IsInstalling}"
                                                    Command="{Binding InstallCommand}" />
                                            <TextBlock Text="{Binding DownloadsText}"
                                                       Classes="muted"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="安装时会自动选择与当前 Minecraft 版本和加载器兼容的最新文件，并递归下载所有必需的前置模组；同名文件不会覆盖。可选前置模组请按需手动安装。"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16"
                  IsVisible="{Binding IsSettingsSection}">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Java 与内存" Classes="h2" FontSize="16" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Java 可执行文件" Classes="label" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding JavaPath}"
                                         PlaceholderText="留空则自动检测" />
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Content="浏览"
                                        Command="{Binding BrowseJavaCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="ghost"
                                        Padding="0,4"
                                        Content="清除路径"
                                        Command="{Binding ClearJavaPathCommand}" />
                                <TextBlock Text="{Binding DetectedJavaText}"
                                           Classes="muted"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="最小内存 (MB)" Classes="label" />
                                <NumericUpDown Value="{Binding MinimumRamMb}"
                                               Minimum="256" Maximum="65536"
                                               Increment="512"
                                               FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="最大内存 (MB)" Classes="label" />
                                <NumericUpDown Value="{Binding MaximumRamMb}"
                                               Minimum="256" Maximum="65536"
                                               Increment="512"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="窗口宽度" Classes="label" />
                                <NumericUpDown Value="{Binding WindowWidth}"
                                               Minimum="854" Maximum="7680"
                                               Increment="10"
                                               FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="窗口高度" Classes="label" />
                                <NumericUpDown Value="{Binding WindowHeight}"
                                               Minimum="480" Maximum="4320"
                                               Increment="10"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="全屏启动游戏"
                                  IsChecked="{Binding FullScreen}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="登录与服务器" Classes="h2" FontSize="16" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="登录方式" Classes="label" />
                            <ComboBox ItemsSource="{Binding LoginModes}"
                                      SelectedIndex="{Binding SelectedLoginModeIndex, Mode=TwoWay}" />
                            <TextBlock Text="「当前账户」复用账户页的登录；Microsoft 模式要求当前已登录微软账户。"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsOfflineLogin}">
                            <TextBlock Text="该版本的离线用户名" Classes="label" />
                            <TextBox Text="{Binding OfflineUsername}"
                                     PlaceholderText="留空则使用全局离线用户名" />
                        </StackPanel>

                        <CheckBox Content="启动后自动进入服务器"
                                  IsChecked="{Binding AutoJoinServer}" />

                        <Grid ColumnDefinitions="*,120" ColumnSpacing="10"
                              IsEnabled="{Binding AutoJoinServer}">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="服务器地址" Classes="label" />
                                <TextBox Text="{Binding ServerAddress}"
                                         PlaceholderText="例如 play.example.com" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="端口" Classes="label" />
                                <NumericUpDown Value="{Binding ServerPort}"
                                               Minimum="1" Maximum="65535"
                                               Increment="1"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="地址支持域名或 IP；默认端口为 25565。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" IsVisible="{Binding IsAdvancedSection}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="高级启动参数" Classes="h2" FontSize="16" />
                        <TextBlock Text="参数会原样附加到 CmlLib 生成的 Java 命令行中，支持引号包裹带空格的参数。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="JVM 参数" Classes="label" />
                        <TextBox Text="{Binding JvmArguments}"
                                 AcceptsReturn="True"
                                 MinHeight="70"
                                 TextWrapping="Wrap"
                                 PlaceholderText="例如 -XX:+UseG1GC -XX:MaxGCPauseMillis=50" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="游戏参数" Classes="label" />
                        <TextBox Text="{Binding GameArguments}"
                                 AcceptsReturn="True"
                                 MinHeight="70"
                                 TextWrapping="Wrap"
                                 PlaceholderText="例如 --width 1920 --height 1080" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="启动前执行命令" Classes="label" />
                        <TextBox Text="{Binding PreLaunchCommand}"
                                 PlaceholderText="例如 startTools.exe --prepare" />
                        <TextBlock Text="在游戏目录下通过 cmd.exe 执行并等待结束；非 0 退出码会阻止启动。支持占位符 {gameDir}、{versionDir}、{version}，也可使用环境变量 PMCL_GAME_DIR、PMCL_VERSION_DIR、PMCL_VERSION。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>


            <Border Classes="card" IsVisible="{Binding IsAdvancedSection}">
                <StackPanel Spacing="12">
                    <TextBlock Text="危险操作"
                               Classes="h2"
                               FontSize="16"
                               Foreground="{StaticResource DangerBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding DeleteWarningText}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="danger"
                                Content="删除版本"
                                IsVisible="{Binding !IsDeleteConfirmVisible}"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding RequestDeleteCommand}" />
                    </Grid>

                    <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                            Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="确定要永久删除此版本吗？此操作不可撤销。"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="danger"
                                        Content="确认删除"
                                        IsEnabled="{Binding !Session.IsBusy}"
                                        Command="{Binding ConfirmDeleteCommand}" />
                                <Button Classes="secondary"
                                        Content="取消"
                                        Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>

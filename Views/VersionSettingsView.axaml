<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PMCL.Localization"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.VersionSettingsView"
             x:DataType="vm:VersionSettingsViewModel">

    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Button Classes="secondary"
                            Content="{loc:Tr Common.Back}"
                            VerticalAlignment="Center"
                            Command="{Binding BackCommand}" />

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Version.Name}"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <Border Background="#1B2233" CornerRadius="6" Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version.TypeLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                                    Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VersionStatusText}"
                                           FontSize="10"
                                           Foreground="#C3B5FF" />
                            </Border>
                            <Border Background="#1B2233" CornerRadius="6"
                                    Padding="7,2" VerticalAlignment="Center"
                                    IsVisible="{Binding HasModLoader}">
                                <TextBlock Text="{Binding CurrentLoaderLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding VersionDirectory}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SaveState}"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                        <Button Classes="primary"
                                Content="{loc:Tr VersionSettings.Save}"
                                Padding="20,9"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="nav"
                            Classes.active="{Binding IsSettingsSection}"
                            Padding="18,8"
                            Content="{loc:Tr Tab.Settings}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Settings" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsModsSection}"
                            Padding="18,8"
                            Content="{loc:Tr Tab.Mods}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Mods" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsContentSection}"
                            Padding="18,8"
                            Content="{loc:Tr Tab.Content}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="ContentPacks" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsModDownloadsSection}"
                            Padding="18,8"
                            Content="{loc:Tr Tab.Modrinth}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="ModDownloads" />
                    <Button Classes="nav"
                            Classes.active="{Binding IsAdvancedSection}"
                            Padding="18,8"
                            Content="{loc:Tr Tab.Advanced}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Advanced" />
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsSettingsSection}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Tr VS.VersionInfo}" Classes="h2" FontSize="16" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr VS.VersionName}" Classes="label" />
                            <TextBox Text="{Binding NewVersionName}"
                                     IsEnabled="{Binding !Session.IsBusy}" />
                            <TextBlock Text="{loc:Tr VS.RenameHint}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{loc:Tr VS.Rename}"
                                VerticalAlignment="Bottom"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding RenameVersionCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsSettingsSection}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr VS.QuickActions}" Classes="h2" FontSize="16" />
                            <TextBlock Text="{loc:Tr VS.QuickActionsHint}"
                                       Classes="muted" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{loc:Tr VS.CompleteFiles}"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding RepairCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                Content="{loc:Tr VS.OpenVersionFolder}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenVersionFolderCommand}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{loc:Tr VS.OpenSaves}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenSavesFolderCommand}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="{loc:Tr VS.OpenScreenshots}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenScreenshotsFolderCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Classes="secondary"
                                Content="{loc:Tr VS.ExportScript}"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding ExportLaunchScriptCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Tr VS.ExportScriptHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsAdvancedSection}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr VS.GameData}" Classes="h2" FontSize="16" />
                        <TextBlock Text="{loc:Tr VS.GameDataHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr VS.CurrentGameDir}" Classes="label" />
                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="#263045"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <TextBlock Text="{Binding GameDirectory}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                Content="{loc:Tr VS.OpenGameDir}"
                                Command="{Binding OpenGameFolderCommand}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                Content="{loc:Tr VS.OpenMods}"
                                Command="{Binding OpenModsFolderCommand}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                HorizontalAlignment="Stretch"
                                Content="{loc:Tr VS.OpenConfig}"
                                Command="{Binding OpenConfigFolderCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Classes="secondary"
                                Content="{loc:Tr VS.ImportShared}"
                                IsEnabled="{Binding CanImportSharedData}"
                                Command="{Binding ImportSharedDataCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Tr VS.ImportSharedHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsModLoaderCardVisible}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Tr VS.ModLoader}" Classes="h2" FontSize="16" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLoaderLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LoaderBaseVersionLabel}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary"
                                    Content="{loc:Tr VS.AddLoader}"
                                    IsVisible="{Binding IsVanillaVersion}"
                                    IsEnabled="{Binding !Session.IsBusy}"
                                    Command="{Binding AddOrChangeLoaderCommand}" />
                            <Button Classes="secondary"
                                    Content="{loc:Tr VS.ChangeLoader}"
                                    IsVisible="{Binding HasModLoader}"
                                    IsEnabled="{Binding !Session.IsBusy}"
                                    Command="{Binding AddOrChangeLoaderCommand}" />
                            <Button Classes="danger"
                                    Content="{loc:Tr VS.RemoveLoader}"
                                    IsVisible="{Binding HasModLoader}"
                                    IsEnabled="{Binding !Session.IsBusy}"
                                    Command="{Binding RequestRemoveLoaderCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Tr VS.LoaderHint}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{loc:Tr VS.LoaderMutexHint}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <Border IsVisible="{Binding IsRemoveLoaderConfirmVisible}"
                            Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr VS.RemoveLoaderConfirm}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="danger"
                                        Content="{loc:Tr VS.ConfirmRemove}"
                                        IsEnabled="{Binding !Session.IsBusy}"
                                        Command="{Binding ConfirmRemoveLoaderCommand}" />
                                <Button Classes="secondary"
                                        Content="{loc:Tr Common.Cancel}"
                                        Command="{Binding CancelRemoveLoaderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsModsSection}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr VS.InstalledMods}" Classes="h2" FontSize="16" />
                            <TextBlock Text="{Binding ModsDirectory}"
                                       Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="{loc:Tr Common.Refresh}"
                                Command="{Binding RefreshModsCommand}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="{loc:Tr VS.OpenMods}"
                                Command="{Binding OpenModsFolderCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary"
                                Content="{loc:Tr VS.Mods.InstallLocal}"
                                Command="{Binding InstallFromLocalCommand}" />
                        <Button Classes="secondary"
                                Content="{loc:Tr VS.Mods.DownloadNew}"
                                Command="{Binding OpenModDownloadsCommand}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding LocalModSearchText}"
                                 PlaceholderText="{loc:Tr VS.SearchMods}" />
                        <CheckBox Grid.Column="1"
                                  Content="{loc:Tr VS.ShowDisabled}"
                                  IsChecked="{Binding ShowDisabledMods}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                        <Button Classes="secondary"
                                Padding="12,7"
                                Content="{Binding SelectAllModsLabel}"
                                IsEnabled="{Binding CanSelectAllMods}"
                                Command="{Binding ToggleSelectAllModsCommand}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Padding="12,7"
                                Content="{loc:Tr VS.Mods.UpdateSelected}"
                                IsEnabled="{Binding CanUpdateSelectedMods}"
                                Command="{Binding UpdateSelectedModsCommand}" />
                        <Button Grid.Column="2"
                                Classes="danger"
                                Padding="12,7"
                                Content="{loc:Tr VS.Mods.DeleteSelected}"
                                IsEnabled="{Binding HasSelectedMods}"
                                Command="{Binding RequestDeleteSelectedModsCommand}" />
                        <TextBlock Grid.Column="3"
                                   Classes="muted"
                                   Text="{Binding SelectedModsText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border IsVisible="{Binding IsBatchDeleteConfirmVisible}"
                            Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="{loc:Tr VS.Mods.DeleteSelectedConfirm}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="danger"
                                    Padding="12,6"
                                    Content="{loc:Tr VS.ConfirmDelete}"
                                    Command="{Binding ConfirmDeleteSelectedModsCommand}" />
                            <Button Grid.Column="2"
                                    Classes="secondary"
                                    Padding="12,6"
                                    Content="{loc:Tr Common.Cancel}"
                                    Command="{Binding CancelDeleteSelectedModsCommand}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding LocalModStatusText}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10"
                          IsVisible="{Binding HasModUpdateStatus}">
                        <ProgressBar Width="90"
                                     Height="4"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsModEnriching}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModUpdateStatusText}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Border IsVisible="{Binding HasNoLocalMods}"
                            Background="{StaticResource FieldBrush}"
                            BorderBrush="#263045"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <TextBlock Text="{loc:Tr VS.NoMods}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding LocalMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModItemViewModel">
                                <Border Classes="modRow"
                                        Classes.error="{Binding HasErrorWarning}"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.Styles>
                                        <Style Selector="Border.modRow">
                                            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                                            <Setter Property="BorderBrush" Value="#263045" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="10" />
                                        </Style>
                                        <Style Selector="Border.modRow.error">
                                            <Setter Property="Background" Value="#241520" />
                                            <Setter Property="BorderBrush" Value="#6E2B39" />
                                        </Style>
                                    </Border.Styles>

                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,4,0,0"
                                                      ToolTip.Tip="{loc:Tr VS.Mods.SelectHint}" />

                                            <Border Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    VerticalAlignment="Top">
                                                <Panel>
                                                    <TextBlock Text="{Binding IconInitial}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="#C3B5FF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding HasIcon}" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <Border Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="10"
                                                                   Foreground="#C3B5FF" />
                                                    </Border>
                                                    <Border Background="#2A1620"
                                                            CornerRadius="6"
                                                            Padding="7,1"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasUpdate}">
                                                        <TextBlock Text="{Binding UpdateBadgeText}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding DetailText}"
                                                           Classes="muted"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding FileName}"
                                                           Classes="muted"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WarningText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasWarning}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Top">
                                                <Button Classes="secondary"
                                                        Padding="12,7"
                                                        Content="{Binding UpdateLabel}"
                                                        IsVisible="{Binding HasUpdate}"
                                                        IsEnabled="{Binding !IsUpdating}"
                                                        Command="{Binding UpdateCommand}" />
                                                <Button Classes="secondary"
                                                        Padding="12,7"
                                                        Content="{Binding ToggleLabel}"
                                                        ToolTip.Tip="{Binding ToggleHint}"
                                                        Command="{Binding ToggleCommand}" />
                                                <Button Classes="danger"
                                                        Padding="12,7"
                                                        Content="{loc:Tr Common.Delete}"
                                                        IsVisible="{Binding !IsDeleteConfirmVisible}"
                                                        Command="{Binding RequestDeleteCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding DescriptionText}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasDescription}" />

                                        <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                                                Background="#2A1620"
                                                BorderBrush="#6E2B39"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{loc:Tr VS.DeleteModConfirm}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Classes="danger"
                                                        Padding="12,6"
                                                        Content="{loc:Tr VS.ConfirmDelete}"
                                                        Command="{Binding ConfirmDeleteCommand}" />
                                                <Button Grid.Column="2"
                                                        Classes="secondary"
                                                        Padding="12,6"
                                                        Content="{loc:Tr Common.Cancel}"
                                                        Command="{Binding CancelDeleteCommand}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsContentSection}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="nav"
                                Classes.active="{Binding IsResourcePacksSelected}"
                                Padding="14,6"
                                Content="{loc:Tr Content.Kind.ResourcePack}"
                                Command="{Binding SelectContentPackKindCommand}"
                                CommandParameter="0" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsShaderPacksSelected}"
                                Padding="14,6"
                                Content="{loc:Tr Content.Kind.ShaderPack}"
                                Command="{Binding SelectContentPackKindCommand}"
                                CommandParameter="1" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsDataPacksSelected}"
                                Padding="14,6"
                                Content="{loc:Tr Content.Kind.DataPack}"
                                Command="{Binding SelectContentPackKindCommand}"
                                CommandParameter="2" />
                    </StackPanel>

                    <ContentControl Content="{Binding ActiveContentGroup}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:ContentPackGroupViewModel">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Title}" Classes="h2" FontSize="16" />
                                            <TextBlock Text="{Binding FolderText}"
                                                       Classes="muted"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Content="{loc:Tr Common.Refresh}"
                                                Command="{Binding RefreshCommand}" />
                                        <Button Grid.Column="2"
                                                Classes="secondary"
                                                Content="{loc:Tr VS.Content.OpenFolder}"
                                                Command="{Binding OpenFolderCommand}" />
                                    </Grid>

                                    <TextBlock Text="{Binding Hint}"
                                               Classes="muted"
                                               TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="10"
                                          IsVisible="{Binding HasMultipleTargets}">
                                        <TextBlock Text="{loc:Tr VS.Content.Target}"
                                                   Classes="muted"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Targets}"
                                                  SelectedIndex="{Binding SelectedTargetIndex, Mode=TwoWay}" />
                                    </Grid>

                                    <Button Classes="primary"
                                            HorizontalAlignment="Left"
                                            Content="{loc:Tr VS.Content.InstallLocal}"
                                            IsEnabled="{Binding IsVersionInstalled}"
                                            Command="{Binding InstallLocalCommand}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding LocalSearchText}"
                                                 PlaceholderText="{loc:Tr VS.Content.SearchLocal}" />
                                        <CheckBox Grid.Column="1"
                                                  Content="{loc:Tr VS.ShowDisabled}"
                                                  IsChecked="{Binding ShowDisabled}"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="{Binding StatusText}"
                                               Classes="muted"
                                               TextWrapping="Wrap" />

                                    <Border IsVisible="{Binding ShowEmptyHint}"
                                            Background="{StaticResource FieldBrush}"
                                            BorderBrush="#263045"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14">
                                        <TextBlock Text="{loc:Tr VS.Content.Empty}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ContentPackItemViewModel">
                                                <Border Background="{StaticResource FieldBrush}"
                                                        BorderBrush="#263045"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="8"
                                                                    Background="{StaticResource AccentSoftBrush}"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding IconInitial}"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           Foreground="#C3B5FF"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FileName}"
                                                                           Classes="muted"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding SizeText}"
                                                                               Classes="muted"
                                                                               FontSize="10" />
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource SuccessBrush}"
                                                                               IsVisible="{Binding IsEnabled}" />
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               Classes="muted"
                                                                               FontSize="10"
                                                                               IsVisible="{Binding !IsEnabled}" />
                                                                    <Border Background="#1B2233"
                                                                            CornerRadius="6"
                                                                            Padding="7,1"
                                                                            IsVisible="{Binding HasContainer}">
                                                                        <TextBlock Text="{Binding ContainerLabel}"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <Button Classes="secondary"
                                                                        Padding="12,7"
                                                                        Content="{Binding ToggleLabel}"
                                                                        ToolTip.Tip="{Binding ToggleHint}"
                                                                        Command="{Binding ToggleCommand}" />
                                                                <Button Classes="danger"
                                                                        Padding="12,7"
                                                                        Content="{loc:Tr Common.Delete}"
                                                                        IsVisible="{Binding !IsDeleteConfirmVisible}"
                                                                        Command="{Binding RequestDeleteCommand}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                                                                Background="#2A1620"
                                                                BorderBrush="#6E2B39"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{loc:Tr VS.Content.DeleteConfirm}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="1"
                                                                        Classes="danger"
                                                                        Padding="12,6"
                                                                        Content="{loc:Tr VS.ConfirmDelete}"
                                                                        Command="{Binding ConfirmDeleteCommand}" />
                                                                <Button Grid.Column="2"
                                                                        Classes="secondary"
                                                                        Padding="12,6"
                                                                        Content="{loc:Tr Common.Cancel}"
                                                                        Command="{Binding CancelDeleteCommand}" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{loc:Tr VS.Content.ModrinthTitle}" Classes="label" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBox Text="{Binding SearchText}"
                                                     PlaceholderText="{loc:Tr VS.Content.SearchHint}"
                                                     IsEnabled="{Binding IsVersionInstalled}" />
                                            <Button Grid.Column="1"
                                                    Classes="primary"
                                                    Content="{Binding SearchButtonText}"
                                                    IsEnabled="{Binding CanSearch}"
                                                    Command="{Binding SearchCommand}" />
                                        </Grid>

                                        <ProgressBar Height="4"
                                                     IsIndeterminate="True"
                                                     IsVisible="{Binding IsSearching}" />

                                        <TextBlock Text="{Binding SearchStatusText}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap" />

                                        <ItemsControl ItemsSource="{Binding Results}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModrinthProjectItemViewModel">
                                                    <Border Background="{StaticResource FieldBrush}"
                                                            BorderBrush="#263045"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12"
                                                            Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Background="{StaticResource AccentSoftBrush}"
                                                                    VerticalAlignment="Top">
                                                                <Panel>
                                                                    <TextBlock Text="{Binding IconInitial}"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"
                                                                               Foreground="#C3B5FF"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Image Source="{Binding Icon}"
                                                                           Stretch="UniformToFill"
                                                                           IsVisible="{Binding HasIcon}" />
                                                                </Panel>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontWeight="SemiBold" />
                                                                    <Border Background="#1B2233"
                                                                            CornerRadius="6"
                                                                            Padding="7,1"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding VersionSummary}"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Classes="muted"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding AuthorText}"
                                                                           Classes="muted"
                                                                           FontSize="10" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        Spacing="6"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Right">
                                                                <Button Classes="primary"
                                                                        Padding="14,8"
                                                                        Content="{Binding InstallLabel}"
                                                                        IsEnabled="{Binding !IsInstalling}"
                                                                        Command="{Binding InstallCommand}" />
                                                                <TextBlock Text="{Binding DownloadsText}"
                                                                           Classes="muted"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsModDownloadsSection}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr VS.ModrinthTitle}" Classes="h2" FontSize="16" />
                        <TextBlock Text="{Binding ModrinthCompatibilityText}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr VS.ModType}" Classes="muted" FontSize="12" />
                            <ComboBox ItemsSource="{Binding ModrinthCategoryOptions}"
                                      SelectedIndex="{Binding SelectedModrinthCategoryIndex}"
                                      IsEnabled="{Binding CanUseModrinth}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModrinthCategoryOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{loc:Tr VS.DownloadSource}" Classes="muted" FontSize="12" />
                            <ComboBox ItemsSource="{Binding ModrinthSourceOptions}"
                                      SelectedIndex="{Binding SelectedModrinthSourceIndex}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Tr VS.SourceUnsupported}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !IsModrinthSourceSelected}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding ModrinthSearchText}"
                                 PlaceholderText="{loc:Tr VS.ModrinthSearchHint}"
                                 IsEnabled="{Binding CanUseModrinth}" />
                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="{Binding ModrinthSearchButtonText}"
                                IsEnabled="{Binding CanSearchModrinth}"
                                Command="{Binding SearchModrinthCommand}" />
                    </Grid>

                    <ProgressBar Height="4"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsModrinthSearching}" />

                    <TextBlock Text="{Binding ModrinthStatusText}"
                               Classes="muted"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding ModrinthResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModrinthProjectItemViewModel">
                                <Border Background="{StaticResource FieldBrush}"
                                        BorderBrush="#263045"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="{StaticResource AccentSoftBrush}"
                                                VerticalAlignment="Top">
                                            <Panel>
                                                <TextBlock Text="{Binding IconInitial}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#C3B5FF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasIcon}" />
                                            </Panel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" />
                                                <Border Background="#1B2233"
                                                        CornerRadius="6"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding VersionSummary}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="muted"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AuthorText}"
                                                       Classes="muted"
                                                       FontSize="10" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Spacing="6"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <Button Classes="primary"
                                                    Padding="14,8"
                                                    Content="{Binding InstallLabel}"
                                                    IsEnabled="{Binding !IsInstalling}"
                                                    Command="{Binding InstallCommand}" />
                                            <TextBlock Text="{Binding DownloadsText}"
                                                       Classes="muted"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Tr VS.ModrinthHint}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16"
                  IsVisible="{Binding IsSettingsSection}">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Tr VS.JavaMemory}" Classes="h2" FontSize="16" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr VS.JavaPath}" Classes="label" />
                            <ComboBox ItemsSource="{Binding JavaRuntimeOptions}"
                                      SelectedItem="{Binding SelectedJavaRuntime, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:JavaRuntimeOption">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   ToolTip.Tip="{Binding Path}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Classes="secondary"
                                        HorizontalAlignment="Stretch"
                                        Content="{loc:Tr Common.Browse}"
                                        Command="{Binding BrowseJavaCommand}" />
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        HorizontalAlignment="Stretch"
                                        Content="{loc:Tr Java.Scan}"
                                        IsEnabled="{Binding !IsScanningJava}"
                                        Command="{Binding ScanJavaCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="ghost"
                                        Padding="0,4"
                                        Content="{loc:Tr Common.ClearPath}"
                                        Command="{Binding ClearJavaPathCommand}" />
                                <TextBlock Text="{Binding JavaScanStatus}"
                                           Classes="muted"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Tr VS.MinMemory}" Classes="label" />
                                <NumericUpDown Value="{Binding MinimumRamMb}"
                                               Minimum="256" Maximum="65536"
                                               Increment="512"
                                               FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{loc:Tr VS.MaxMemory}" Classes="label" />
                                <NumericUpDown Value="{Binding MaximumRamMb}"
                                               Minimum="256" Maximum="65536"
                                               Increment="512"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Tr VS.WindowWidth}" Classes="label" />
                                <NumericUpDown Value="{Binding WindowWidth}"
                                               Minimum="854" Maximum="7680"
                                               Increment="10"
                                               FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{loc:Tr VS.WindowHeight}" Classes="label" />
                                <NumericUpDown Value="{Binding WindowHeight}"
                                               Minimum="480" Maximum="4320"
                                               Increment="10"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{loc:Tr VS.FullScreen}"
                                  IsChecked="{Binding FullScreen}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Tr VS.LoginServer}" Classes="h2" FontSize="16" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr VS.LoginMode}" Classes="label" />
                            <ComboBox ItemsSource="{Binding LoginModes}"
                                      SelectedIndex="{Binding SelectedLoginModeIndex, Mode=TwoWay}" />
                            <TextBlock Text="{loc:Tr VS.LoginModeHint}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsOfflineLogin}">
                            <TextBlock Text="{loc:Tr VS.OfflineUsername}" Classes="label" />
                            <TextBox Text="{Binding OfflineUsername}"
                                     PlaceholderText="{loc:Tr VS.OfflineUsernameHint}" />
                        </StackPanel>

                        <CheckBox Content="{loc:Tr VS.AutoJoin}"
                                  IsChecked="{Binding AutoJoinServer}" />

                        <Grid ColumnDefinitions="*,120" ColumnSpacing="10"
                              IsEnabled="{Binding AutoJoinServer}">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Tr VS.ServerAddress}" Classes="label" />
                                <TextBox Text="{Binding ServerAddress}"
                                         PlaceholderText="{loc:Tr VS.ServerPlaceholder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{loc:Tr VS.Port}" Classes="label" />
                                <NumericUpDown Value="{Binding ServerPort}"
                                               Minimum="1" Maximum="65535"
                                               Increment="1"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Tr VS.ServerHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" IsVisible="{Binding IsAdvancedSection}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr VS.AdvancedArgs}" Classes="h2" FontSize="16" />
                        <TextBlock Text="{loc:Tr VS.AdvancedArgsHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr VS.JvmArgs}" Classes="label" />
                        <TextBox Text="{Binding JvmArguments}"
                                 AcceptsReturn="True"
                                 MinHeight="70"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{loc:Tr VS.JvmPlaceholder}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr VS.GameArgs}" Classes="label" />
                        <TextBox Text="{Binding GameArguments}"
                                 AcceptsReturn="True"
                                 MinHeight="70"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{loc:Tr VS.GameArgsPlaceholder}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr VS.PreLaunch}" Classes="label" />
                        <TextBox Text="{Binding PreLaunchCommand}"
                                 PlaceholderText="{loc:Tr VS.PreLaunchPlaceholder}" />
                        <TextBlock Text="{loc:Tr VS.PreLaunchHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>


            <Border Classes="card" IsVisible="{Binding IsAdvancedSection}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Tr VS.Danger}"
                               Classes="h2"
                               FontSize="16"
                               Foreground="{StaticResource DangerBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding DeleteWarningText}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="danger"
                                Content="{loc:Tr VS.DeleteVersion}"
                                IsVisible="{Binding !IsDeleteConfirmVisible}"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding RequestDeleteCommand}" />
                    </Grid>

                    <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                            Background="#2A1620"
                            BorderBrush="#6E2B39"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr VS.DeleteVersionConfirm}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="danger"
                                        Content="{loc:Tr VS.ConfirmDelete}"
                                        IsEnabled="{Binding !Session.IsBusy}"
                                        Command="{Binding ConfirmDeleteCommand}" />
                                <Button Classes="secondary"
                                        Content="{loc:Tr Common.Cancel}"
                                        Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
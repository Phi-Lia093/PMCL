<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:models="using:PMCL.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.AccountView"
             x:DataType="vm:AccountViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="58" Height="58"
                            CornerRadius="29"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Session.AccountInitial}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Session.AccountName}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Session.AccountKindLabel}" Classes="muted" />
                        <TextBlock Text="{Binding Session.AccountDetailText}"
                                   Classes="muted"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="退出当前账户"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Session.HasAccount}"
                            Command="{Binding SignoutCommand}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1B3A5C">
                                <TextBlock Text="MS"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#7FC4FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Microsoft 账户"
                                       Classes="h2"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="通过微软官方设备码登录。登录页在系统默认浏览器中打开，不依赖 WebView2；授权完成后启动器自动登录，无需粘贴回调链接或令牌。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />

                        <Button Classes="primary"
                                HorizontalAlignment="Left"
                                Content="使用 Microsoft 登录"
                                Margin="0,6,0,0"
                                IsVisible="{Binding !IsMicrosoftLoginPending}"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding LoginMicrosoftCommand}" />

                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="#263045"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                IsVisible="{Binding IsMicrosoftLoginPending}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="在浏览器中完成授权"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="浏览器已打开微软授权页，并会尝试自动填入下面的代码。若页面没有自动填入，请手动输入该代码；授权成功后启动器会自动完成登录。"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                                <Border Background="#101725"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="登录代码"
                                                   Classes="muted"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center" />
                                        <TextBox Text="{Binding MicrosoftLoginCode, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"
                                                 FontSize="26"
                                                 FontWeight="SemiBold"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="代码约 15 分钟内有效。请不要把代码分享给他人；启动器会自动轮询登录结果，无需再复制任何内容。"
                                           Classes="muted"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding MicrosoftLoginUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontSize="10"
                                         MaxHeight="54"
                                         IsVisible="{Binding HasMicrosoftLoginUrl}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary"
                                            Content="重新打开浏览器"
                                            Command="{Binding OpenMicrosoftLoginUrlCommand}" />
                                    <Button Classes="ghost"
                                            Content="取消"
                                            Command="{Binding CancelMicrosoftLoginCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding MicrosoftLoginHint}"
                                           Classes="muted"
                                           IsVisible="{Binding HasMicrosoftLoginHint}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1E3A2A">
                                <TextBlock Text="OFF"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#7CE0A6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="离线账户"
                                       Classes="h2"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="无需网络验证，仅适用于单人与局域网游戏。用户名长度为 3 - 16 个字符，添加后会保存在账户列表中。"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <TextBox PlaceholderText="输入离线用户名"
                                 Text="{Binding OfflineUsername, Mode=TwoWay}"
                                 MaxLength="16" />
                        <Button Classes="secondary"
                                HorizontalAlignment="Left"
                                Content="添加并使用离线账户"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding LoginOfflineCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="已保存账户"
                                       Classes="h2"
                                       FontSize="16" />
                            <TextBlock Text="{Binding SavedAccountsSummary}"
                                       Classes="muted" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="刷新"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshSavedAccountsCommand}" />
                    </Grid>

                    <TextBlock Text="暂无已保存账户。登录 Microsoft 或添加离线账户后会显示在这里。"
                               Classes="muted"
                               IsVisible="{Binding !HasSavedAccounts}" />

                    <ListBox ItemsSource="{Binding Session.SavedAccounts}"
                             SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                             IsVisible="{Binding HasSavedAccounts}"
                             MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SavedAccount">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="2">
                                    <Border Width="38" Height="38"
                                            CornerRadius="19"
                                            Background="#1B2233">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="6"
                                                    Padding="6,1"
                                                    IsVisible="{Binding IsActive}">
                                                <TextBlock Text="当前"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding KindLabel}" Classes="muted" />
                                            <TextBlock Text="{Binding Gamertag}"
                                                       Classes="muted"
                                                       IsVisible="{Binding HasGamertag}" />
                                            <TextBlock Text="{Binding TokenStateText}"
                                                       Classes="muted"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding LastAccessText}"
                                                   Classes="muted"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Uuid}"
                                                   Classes="muted"
                                                   FontSize="9"
                                                   MaxLines="1"
                                                   MaxWidth="160"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary"
                                Content="使用选中账户"
                                IsEnabled="{Binding HasSelectedAccount}"
                                Command="{Binding UseSavedAccountCommand}"
                                CommandParameter="{Binding SelectedAccount}" />
                        <Button Classes="danger"
                                Content="删除选中账户"
                                IsEnabled="{Binding HasSelectedAccount}"
                                Command="{Binding RemoveSavedAccountCommand}"
                                CommandParameter="{Binding SelectedAccount}" />
                    </StackPanel>

                    <TextBlock Text="Microsoft 账户的刷新令牌仅保存在本机账户文件中。删除账户会同时删除该文件中的登录凭据。"
                               Classes="muted"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>


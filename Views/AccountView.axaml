<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PMCL.Localization"
             xmlns:vm="using:PMCL.ViewModels"
             xmlns:models="using:PMCL.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="PMCL.Views.AccountView"
             x:DataType="vm:AccountViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,6,16">

            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="58" Height="58"
                            CornerRadius="29"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Session.AccountInitial}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Session.AccountName}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Session.AccountKindLabel}" Classes="muted" />
                        <TextBlock Text="{Binding Session.AccountDetailText}"
                                   Classes="muted"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="{loc:Tr Account.SignOut}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Session.HasAccount}"
                            Command="{Binding SignoutCommand}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1B3A5C">
                                <TextBlock Text="MS"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#7FC4FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Tr Account.Microsoft}"
                                       Classes="h2"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Account.MicrosoftHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />

                        <Button Classes="primary"
                                HorizontalAlignment="Left"
                                Content="{loc:Tr Account.LoginMicrosoft}"
                                Margin="0,6,0,0"
                                IsVisible="{Binding !IsMicrosoftLoginPending}"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding LoginMicrosoftCommand}" />

                        <Border Background="{StaticResource FieldBrush}"
                                BorderBrush="#263045"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                IsVisible="{Binding IsMicrosoftLoginPending}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Tr Account.BrowserTitle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr Account.BrowserHint}"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                                <Border Background="#101725"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr Account.LoginCode}"
                                                   Classes="muted"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center" />
                                        <TextBox Text="{Binding MicrosoftLoginCode, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"
                                                 FontSize="26"
                                                 FontWeight="SemiBold"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:Tr Account.CodeValidity}"
                                           Classes="muted"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding MicrosoftLoginUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontSize="10"
                                         MaxHeight="54"
                                         IsVisible="{Binding HasMicrosoftLoginUrl}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary"
                                            Content="{loc:Tr Account.ReopenBrowser}"
                                            Command="{Binding OpenMicrosoftLoginUrlCommand}" />
                                    <Button Classes="ghost"
                                            Content="{loc:Tr Common.Cancel}"
                                            Command="{Binding CancelMicrosoftLoginCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding MicrosoftLoginHint}"
                                           Classes="muted"
                                           IsVisible="{Binding HasMicrosoftLoginHint}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1E3A2A">
                                <TextBlock Text="OFF"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#7CE0A6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Tr Account.Offline}"
                                       Classes="h2"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Account.OfflineHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <TextBox PlaceholderText="{loc:Tr Account.OfflinePlaceholder}"
                                 Text="{Binding OfflineUsername, Mode=TwoWay}"
                                 MaxLength="16" />
                        <Button Classes="secondary"
                                HorizontalAlignment="Left"
                                Content="{loc:Tr Account.AddOffline}"
                                IsEnabled="{Binding !Session.IsBusy}"
                                Command="{Binding LoginOfflineCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Tr Account.Saved}"
                                       Classes="h2"
                                       FontSize="16" />
                            <TextBlock Text="{Binding SavedAccountsSummary}"
                                       Classes="muted" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="{loc:Tr Common.Refresh}"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshSavedAccountsCommand}" />
                    </Grid>

                    <TextBlock Text="{loc:Tr Account.NoSaved}"
                               Classes="muted"
                               IsVisible="{Binding !HasSavedAccounts}" />

                    <ListBox ItemsSource="{Binding Session.SavedAccounts}"
                             SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                             IsVisible="{Binding HasSavedAccounts}"
                             MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SavedAccount">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="2">
                                    <Border Width="38" Height="38"
                                            CornerRadius="19"
                                            Background="#1B2233">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="6"
                                                    Padding="6,1"
                                                    IsVisible="{Binding IsActive}">
                                                <TextBlock Text="{loc:Tr Account.Current}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding KindLabel}" Classes="muted" />
                                            <TextBlock Text="{Binding Gamertag}"
                                                       Classes="muted"
                                                       IsVisible="{Binding HasGamertag}" />
                                            <TextBlock Text="{Binding TokenStateText}"
                                                       Classes="muted"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding LastAccessText}"
                                                   Classes="muted"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Uuid}"
                                                   Classes="muted"
                                                   FontSize="9"
                                                   MaxLines="1"
                                                   MaxWidth="160"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary"
                                Content="{loc:Tr Account.UseSelected}"
                                IsEnabled="{Binding HasSelectedAccount}"
                                Command="{Binding UseSavedAccountCommand}"
                                CommandParameter="{Binding SelectedAccount}" />
                        <Button Classes="danger"
                                Content="{loc:Tr Account.DeleteSelected}"
                                IsEnabled="{Binding HasSelectedAccount}"
                                Command="{Binding RemoveSavedAccountCommand}"
                                CommandParameter="{Binding SelectedAccount}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Account.CredentialNote}"
                               Classes="muted"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
